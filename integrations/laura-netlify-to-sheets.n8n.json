      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.netlify.com/api/v1/forms/6b04b3b6186beb05f23848db/submissions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
