    },
    {
      "id": "laura-onlynew",
      "name": "Solo nuevos por ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const present=new Set($input.all().map(x=>String(x.json['ID de envío Netlify']||'')).filter(Boolean));\nreturn $('Validar y clasificar solicitudes').all().filter(x=>!present.has(String(x.json['ID de envío Netlify'])));"
      }
    },
